meta {
  name: Create Order
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

body:json {
  {
    "cartId": "{{cartId}}",
    "clientId": "{{clientId}}",
    "restaurant": "damichele",
    "deliveryAddress": "12 rue de la Pizza, Paris"
  }
}

script:post-response {
  bru.setEnvVar("orderId", res.body.orderId);
}
